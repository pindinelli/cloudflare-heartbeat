{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "cloudflare-heartbeat-bot",
    "main": "src/webhook.ts",
    "compatibility_date": "2026-09-18",
    "observability": {
        "enabled": true
    },
    "kv_namespaces": [
        {
            "binding": "SERVER_STATUS",
